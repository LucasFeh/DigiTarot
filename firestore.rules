rules_version = '2';

// Regras do Firestore. A vitrine pública vem da coleção `tarologos`, mas quem
// de fato protege os dados é este arquivo, executado no servidor.
//
// Publicar:  Firebase Console › Firestore Database › Regras › colar › Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    /**
     * A conta administrativa inicial é identificada no servidor pelo e-mail
     * verificado. Os demais tarólogos são reconhecidos por um documento criado
     * previamente pelo administrador em `tarologos/{email-normalizado}`.
     *
     * `token.get('email', '')`, e NUNCA `token.email`: quem entra por SMS tem um
     * token sem a chave `email`, e nas regras do Firestore ler um campo ausente
     * não devolve null — derruba a avaliação INTEIRA com erro, que o servidor
     * conta como negada. Como esta função é chamada em quase toda regra, a forma
     * direta trancaria o cliente de telefone para fora até do que é dele.
     *
     * `email_verified` NÃO é zelo extra, é o que fecha a porta. Este arquivo é
     * público, então o endereço do tarólogo é conhecido — e o Firebase deixa
     * qualquer um criar conta por e-mail e senha com QUALQUER endereço, sem
     * provar que o possui. Sem esta linha, bastaria alguém se cadastrar com o
     * e-mail daqui para virar tarólogo: ler a agenda inteira, confirmar
     * pagamento e abrir mesa. Com ela, é preciso provar posse da caixa de
     * entrada — o que o login pelo Google faz sozinho, e o cadastro por senha
     * só consegue clicando num link que chega ao Rodrigo.
     */
    function emailVerificado() {
      return logado()
             && request.auth.token.get('email_verified', false) == true
             && request.auth.token.get('email', '') is string;
    }

    // E-mail/senha e Google precisam de endereço confirmado. Quem entrou só
    // por SMS já comprovou a posse do telefone e não tem e-mail para confirmar.
    function contaConfirmada() {
      return emailVerificado()
             || (logado()
                 && request.auth.token.get('email', '') == ''
                 && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'phone');
    }

    function perfilId() {
      return request.auth.token.get('email', '').lower();
    }

    function ehAdmin() {
      return emailVerificado() && perfilId() == 'rodriv.l680@gmail.com';
    }

    function perfilTarologo(id) {
      return get(/databases/$(database)/documents/tarologos/$(id)).data;
    }

    function tarologoAtivo(id) {
      return id is string
             && exists(/databases/$(database)/documents/tarologos/$(id))
             && perfilTarologo(id).get('ativo', false) == true;
    }

    function donoTarologo(id) {
      return emailVerificado()
             && perfilId() == id
             && exists(/databases/$(database)/documents/tarologos/$(id));
    }

    function ehTarologo() {
      return ehAdmin() || donoTarologo(perfilId());
    }

    /** Só os campos listados mudaram nesta escrita. */
    function mexeuSoEm(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function fotoDaCartaValida() {
      let valor = request.resource.data.foto;
      return valor is string
             && valor.size() <= 260000
             && valor.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }

    function chibiDaCartaValido() {
      let valor = request.resource.data.personagem;
      return valor is string
             && (valor == '' || (valor.size() <= 320000
                 && valor.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')));
    }

    function edicaoDaCartaPeloDono(id) {
      let campos = request.resource.data.diff(resource.data).affectedKeys();
      return donoTarologo(id)
             && campos.hasOnly(['foto', 'personagem', 'cartaoPublicado'])
             && request.resource.data.get('cartaoPublicado', false) is bool
             && request.resource.data.foto is string
             && request.resource.data.foto.size() > 0
             && (!campos.hasAny(['foto']) || fotoDaCartaValida())
             && (!campos.hasAny(['personagem']) || chibiDaCartaValido());
    }

    function especializacoesValidas(lista) {
      return lista is list && lista.size() <= 8
             && (lista.size() < 1 || (lista[0] is string && lista[0].size() > 0 && lista[0].size() <= 40))
             && (lista.size() < 2 || (lista[1] is string && lista[1].size() > 0 && lista[1].size() <= 40))
             && (lista.size() < 3 || (lista[2] is string && lista[2].size() > 0 && lista[2].size() <= 40))
             && (lista.size() < 4 || (lista[3] is string && lista[3].size() > 0 && lista[3].size() <= 40))
             && (lista.size() < 5 || (lista[4] is string && lista[4].size() > 0 && lista[4].size() <= 40))
             && (lista.size() < 6 || (lista[5] is string && lista[5].size() > 0 && lista[5].size() <= 40))
             && (lista.size() < 7 || (lista[6] is string && lista[6].size() > 0 && lista[6].size() <= 40))
             && (lista.size() < 8 || (lista[7] is string && lista[7].size() > 0 && lista[7].size() <= 40));
    }

    function edicaoDaApresentacaoPeloDono(id) {
      let campos = request.resource.data.diff(resource.data).affectedKeys();
      let anos = request.resource.data.get('anosExperiencia', null);
      let bio = request.resource.data.get('bio', '');
      let abordagem = request.resource.data.get('abordagem', '');
      let tags = request.resource.data.get('especializacoes', []);
      return donoTarologo(id)
             && campos.hasOnly(['anosExperiencia', 'especializacoes', 'bio', 'abordagem'])
             && (!campos.hasAny(['anosExperiencia']) || (anos == null || (anos is int && anos >= 0 && anos <= 80)))
             && (!campos.hasAny(['bio']) || (bio is string && bio.size() <= 1000))
             && (!campos.hasAny(['abordagem']) || (abordagem is string && abordagem.size() <= 300))
             && (!campos.hasAny(['especializacoes']) || especializacoesValidas(tags));
    }

    // ------------------------------- perfis -------------------------------
    // O registro de cada pessoa. É dela, e só dela; o atendimento usa os dados
    // mínimos já copiados no agendamento.
    match /perfis/{usuarioId} {
      allow read: if contaConfirmada() && (uid() == usuarioId || ehAdmin());
      allow write: if contaConfirmada() && uid() == usuarioId;
    }

    // A vitrine é pública; papel, avaliações e preços não vêm de perfis
    // editáveis pelo usuário. Admin cria pelo e-mail antes mesmo do login.
    match /tarologos/{tarologoId} {
      allow read: if true;
      allow create: if ehAdmin()
                    && request.resource.data.uid == tarologoId
                    && request.resource.data.email == tarologoId
                    && request.resource.data.modalidades is map;
      allow update: if (ehAdmin() || edicaoDaCartaPeloDono(tarologoId) || edicaoDaApresentacaoPeloDono(tarologoId))
                    && request.resource.data.uid == tarologoId
                    && request.resource.data.email == tarologoId
                    && request.resource.data.modalidades is map;
      allow delete: if ehAdmin();
    }

    // A chave Pix é legível pelo recebedor, admin e cliente com reserva válida.
    // Ela nunca sai na consulta pública da vitrine.
    match /pixTarologos/{tarologoId} {
      function acessoCliente() {
        let caminho = /databases/$(database)/documents/pixAcessos/$(tarologoId + '_' + uid());
        return contaConfirmada()
               && exists(caminho)
               && get(caminho).data.clienteUid == uid()
               && get(caminho).data.tarologoUid == tarologoId;
      }
      allow get: if ehAdmin() || donoTarologo(tarologoId) || acessoCliente();
      allow list: if false;
      allow create, update: if ehAdmin()
                            && request.resource.data.keys().hasOnly(['chave', 'nome', 'cidade'])
                            && request.resource.data.chave is string
                            && request.resource.data.chave.size() > 0
                            && request.resource.data.nome is string
                            && request.resource.data.nome.size() > 0
                            && request.resource.data.cidade is string
                            && request.resource.data.cidade.size() > 0;
      allow delete: if ehAdmin();
    }

    match /pixAcessos/{acessoId} {
      allow read: if false;
      allow create, update: if contaConfirmada()
                            && acessoId == request.resource.data.tarologoUid + '_' + uid()
                            && request.resource.data.clienteUid == uid()
                            && request.resource.data.agendamentoId is string
                            && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.clienteUid == uid()
                            && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.tarologoUid == request.resource.data.tarologoUid
                            && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.status != 'cancelado';
      allow delete: if false;
    }

    // ------------------------------ horários ------------------------------
    // A trava contra reserva dupla. O id do documento É o encaixe
    // (`2026-09-20T16:00`), e a coleção só aceita CREATE: quando o documento já
    // existe, a mesma escrita passa a contar como update e o servidor recusa.
    // Dois clientes clicando no mesmo minuto — o caso que uma conferência na
    // tela não resolve — terminam com um reservado e outro avisado.
    //
    // A leitura é aberta a quem está logado porque o calendário precisa saber
    // quais minutos caíram. E por isso o documento guarda só o uid de quem
    // reservou: nome, contato e valor ficam em `agendamentos`, que é fechado.
    match /horarios/{slot} {
      allow read: if contaConfirmada();
      allow create: if contaConfirmada()
                    && request.resource.data.uid == uid()
                    && !exists(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId))
                    && slot == request.resource.data.tarologoUid + '_'
                               + getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.data
                               + 'T'
                               + getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.hora
                    && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.clienteUid == uid()
                    && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.status == 'aguardando'
                    && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.tarologoUid == request.resource.data.tarologoUid;
      allow update: if false;
      allow delete: if contaConfirmada()
                    && (ehAdmin() || resource.data.uid == uid() || donoTarologo(resource.data.get('tarologoUid', '')))
                    && getAfter(/databases/$(database)/documents/agendamentos/$(resource.data.agendamentoId)).data.status == 'cancelado';
    }

    // ---------------------------- agendamentos ----------------------------
    match /agendamentos/{agendamentoId} {
      allow read: if contaConfirmada() && (resource.data.clienteUid == uid()
                                 || ehAdmin()
                                 || donoTarologo(resource.data.get('tarologoUid', '')));

      allow create: if contaConfirmada()
                    && request.resource.data.clienteUid == uid()
                    // Ninguém nasce pago: quem confirma pagamento é o tarólogo.
                    && request.resource.data.status == 'aguardando'
                    // Nem já com mesa aberta.
                    && !('sessaoId' in request.resource.data)
                    && request.resource.data.preco is number
                    && request.resource.data.preco > 0
                    && request.resource.data.planoId is string
                    && tarologoAtivo(request.resource.data.tarologoUid)
                    && perfilTarologo(request.resource.data.tarologoUid).modalidades.get(request.resource.data.planoId, 0) == request.resource.data.preco
                    && exists(/databases/$(database)/documents/pixTarologos/$(request.resource.data.tarologoUid))
                    && get(/databases/$(database)/documents/pixTarologos/$(request.resource.data.tarologoUid)).data.chave.size() > 0
                    && getAfter(/databases/$(database)/documents/pixAcessos/$(request.resource.data.tarologoUid + '_' + uid())).data.agendamentoId == agendamentoId
                    && getAfter(/databases/$(database)/documents/horarios/$(request.resource.data.tarologoUid + '_' + request.resource.data.data + 'T' + request.resource.data.hora)).data.agendamentoId == agendamentoId;

      // Administrador e tarólogo responsável só executam transições previstas;
      // preço, cliente, modalidade e horário continuam imutáveis para auditoria.
      // O cliente só pode avisar que pagou ou desistir.
      allow update: if ((ehAdmin() || donoTarologo(resource.data.get('tarologoUid', '')))
                        && (
                          (mexeuSoEm(['status', 'confirmadoEm'])
                           && resource.data.status in ['aguardando', 'pago']
                           && request.resource.data.status == 'confirmado'
                           && request.resource.data.confirmadoEm is string)
                          || (mexeuSoEm(['status'])
                              && resource.data.status in ['aguardando', 'pago', 'confirmado']
                              && request.resource.data.status == 'cancelado')
                          || (mexeuSoEm(['sessaoId'])
                              && resource.data.status == 'confirmado'
                              && request.resource.data.sessaoId is string
                              && get(/databases/$(database)/documents/sessoes/$(request.resource.data.sessaoId)).data.agendamentoId == agendamentoId
                              && get(/databases/$(database)/documents/sessoes/$(request.resource.data.sessaoId)).data.tarologoUid == uid())
                          || (mexeuSoEm(['atendidoEm'])
                              && resource.data.status == 'confirmado'
                              && !('atendidoEm' in resource.data)
                              && request.resource.data.atendidoEm is string)
                        ))
                    || (
                      contaConfirmada()
                      && resource.data.clienteUid == uid()
                      && mexeuSoEm(['status'])
                      && ((resource.data.status == 'aguardando' && request.resource.data.status in ['pago', 'cancelado'])
                          || (resource.data.status == 'pago' && request.resource.data.status == 'cancelado'))
                    );

      // Agendamentos são preservados como histórico; cancelamento é um status.
      allow delete: if false;
    }

    // --------------------------- sessões particulares ---------------------------
    // O tarólogo abre uma mesa avulsa e manda o link para quem quiser. Do outro
    // lado NÃO há conta: quem tem o endereço entra.
    //
    // A separação entre `get` e `list` é o coração desta regra, e é a metade que
    // costuma ser esquecida. `allow read` concede as duas de uma vez — e com
    // `list` liberado, qualquer pessoa pediria a coleção inteira e receberia
    // todos os convites, com todos os tokens, de uma vez só. Aí o endereço
    // imprevisível não protegeria mais nada. Liberar `get` e proibir `list` é o
    // que faz "só quem tem o link" significar alguma coisa.
    match /convites/{token} {
      allow get: if true;

      // `list` fica fechado para o mundo e aberto para o tarólogo — e não
      // fechado para todos, como estava. Todo convite é dele; sem poder
      // consultá-los, a própria tela de sessões particulares ficava vazia para
      // sempre, porque uma consulta ao Firestore é uma operação `list` e a
      // negativa chegava calada na assinatura.
      allow list: if ehAdmin() || (ehTarologo() && resource.data.tarologoUid == uid());

      allow create: if ehTarologo() && request.resource.data.tarologoUid == uid();

      // O tarólogo dono manda no convite. O convidado, sem conta nenhuma, pode
      // exatamente duas coisas: dizer como se chama e avisar que pagou. Não
      // pode mexer no valor, não pode se dar por confirmado, não pode abrir a
      // mesa — nem que reescreva a requisição à mão.
      allow update: if (ehTarologo() && resource.data.tarologoUid == uid())
                    || mexeuSoEm(['convidadoNome'])
                    || (
                      mexeuSoEm(['status'])
                      && resource.data.status == 'aguardando'
                      && request.resource.data.status == 'pago'
                    );

      allow delete: if ehTarologo() && resource.data.tarologoUid == uid();
    }

    // -------------------------------- mesas --------------------------------
    // Cada mesa é de uma consulta só. Quem não participa dela não lê nada —
    // nem com o link, que é o que torna a sala exclusiva de quem agendou.
    //
    // A exceção é a mesa de sessão particular (`publica`), onde o id da sessão
    // faz as vezes de senha. Vale a mesma divisão dos convites: `get` liberado,
    // `list` proibido — a listagem continua restrita a quem participa, senão o
    // "só quem tem o link" cairia por terra na primeira consulta à coleção.
    match /sessoes/{sessaoId} {
      allow get: if resource.data.get('publica', false) == true
                 || (
                   contaConfirmada()
                   && (resource.data.tarologoUid == uid()
                       || resource.data.get('clienteUid', null) == uid())
                 );

      allow list: if contaConfirmada()
                  && (resource.data.tarologoUid == uid()
                      || resource.data.get('clienteUid', null) == uid());

      // Só o tarólogo abre mesa, e sempre em nome próprio.
      allow create: if ehTarologo() && request.resource.data.tarologoUid == uid();

      // O tarólogo dono edita à vontade.
      //
      // O cliente tem exatamente duas janelas, e nada além:
      //   1. registrar-se na sessão, se ela ainda estiver livre (só as mesas
      //      antigas, de antes do agendamento, nascem sem cliente);
      //   2. gravar o PRÓPRIO tema (`visualCliente`), depois de já ser o
      //      cliente dela.
      // Sem a segunda, escolher um tema como cliente falharia calado no
      // Firestore — o modelo de "cada um vê o seu" não sobreviveria ao backend
      // real. E ela não deixa tocar em carta, layout nem no tema do tarólogo.
      //
      // `get(campo, null)` em vez de `resource.data.campo`: sessão gravada
      // antes deste campo existir não tem a chave, e o acesso direto a um
      // campo ausente faz a regra INTEIRA falhar, não devolver null.
      allow update: if contaConfirmada() && (
        resource.data.tarologoUid == uid()
        || (
          resource.data.get('clienteUid', null) == null
          && request.resource.data.clienteUid == uid()
          && mexeuSoEm(['clienteUid', 'clienteNome'])
        )
        || (
          resource.data.get('clienteUid', null) == uid()
          && mexeuSoEm(['visualCliente'])
        )
      );

      allow delete: if contaConfirmada() && resource.data.tarologoUid == uid();

      // ------------------------------ conversa ------------------------------
      // O chat da mesa. Fica numa subcoleção, e não num campo da sessão, por
      // dois motivos: uma conversa cresce sem limite e estouraria o teto de
      // 1 MiB do documento, e duas pessoas escrevendo ao mesmo tempo num array
      // sobrescreveriam uma à outra — a última gravação venceria, e a mensagem
      // da outra sumiria.
      //
      // Quem pode ler a mesa pode ler e escrever nela. `get()` busca o
      // documento-pai para saber disso, inclusive quando não há ninguém logado:
      // é assim que o convidado de sessão particular participa da conversa.
      match /mensagens/{mensagemId} {
        function mesa() {
          return get(/databases/$(database)/documents/sessoes/$(sessaoId)).data;
        }
        function participa() {
          return mesa().get('publica', false) == true
                 || (
                   contaConfirmada()
                   && (mesa().tarologoUid == uid() || mesa().get('clienteUid', null) == uid())
                 );
        }

        allow read: if participa();

        // Uma mensagem tem texto, imagem, ou os dois — mas nunca nada. O teto
        // da imagem é o que impede alguém de empurrar um documento perto do
        // limite de 1 MiB do Firestore e derrubar a conversa inteira: acima
        // disso a gravação falharia no servidor, e do lado de cá pareceria que
        // o chat parou de funcionar sem motivo.
        allow create: if participa()
                      && request.resource.data.keys().hasOnly(['autor', 'nome', 'texto', 'imagem', 'audio', 'em'])
                      && request.resource.data.autor in ['tarologo', 'cliente']
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() <= 100
                      && request.resource.data.em is string
                      && request.resource.data.em.size() <= 50
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() <= 2000
                      && (
                        request.resource.data.texto.size() > 0
                        || 'imagem' in request.resource.data
                        || 'audio' in request.resource.data
                      )
                      && (
                        !('imagem' in request.resource.data)
                        || (
                          request.resource.data.imagem is string
                          && request.resource.data.imagem.size() > 0
                          && request.resource.data.imagem.size() <= 700000
                        )
                      )
                      && (
                        !('audio' in request.resource.data)
                        || (
                          request.resource.data.audio is string
                          && request.resource.data.audio.matches('^data:audio/[a-zA-Z0-9.+-]+;base64,[a-zA-Z0-9+/=]+$')
                          && request.resource.data.audio.size() <= 700000
                        )
                      )
                      && !('imagem' in request.resource.data && 'audio' in request.resource.data);

        // Mensagem dita não se desdiz: sem edição e sem apagar, a conversa que
        // as duas pessoas leram continua sendo a mesma para as duas.
        allow update, delete: if false;
      }

      // SDP de WebRTC: só troca endereços de conexão. Vídeo e áudio seguem
      // diretamente entre os navegadores; nenhum fluxo fica no Firestore.
      // O id aleatório da câmera é uma capacidade temporária para o celular
      // do tarólogo, que pode abrir o QR sem fazer login nesse segundo aparelho.
      match /sinais/{sinalId} {
        function mesa() {
          return get(/databases/$(database)/documents/sessoes/$(sessaoId)).data;
        }
        function dono() {
          return contaConfirmada() && mesa().tarologoUid == uid();
        }
        function cliente() {
          return mesa().get('publica', false) == true
                 || (contaConfirmada() && mesa().get('clienteUid', null) == uid());
        }
        function camera() {
          return sinalId.matches('^camera-[0-9a-f]{32}$');
        }
        function valido() {
          return request.resource.data.keys().hasOnly(['tipo', 'versao', 'oferta', 'resposta', 'expiraEm'])
                 && request.resource.data.tipo in ['camera', 'video', 'voz']
                 && ((camera() && request.resource.data.tipo == 'camera')
                     || (sinalId in ['video', 'voz'] && request.resource.data.tipo == sinalId))
                 && request.resource.data.versao is string
                 && request.resource.data.versao.size() <= 50
                 && request.resource.data.get('oferta', '') is string
                 && request.resource.data.get('oferta', '').size() <= 50000
                 && request.resource.data.get('resposta', '') is string
                 && request.resource.data.get('resposta', '').size() <= 50000;
        }

        allow get: if (camera()
                       && resource.data.tipo == 'camera'
                       && request.time < timestamp.value(resource.data.expiraEm))
                      || (!camera() && (dono() || cliente()));
        allow list: if false;
        allow create: if dono() && valido()
                      && ((camera() && request.resource.data.tipo == 'camera'
                           && request.resource.data.expiraEm is int
                           && request.time < timestamp.value(request.resource.data.expiraEm)
                           && request.resource.data.expiraEm < request.time.toMillis() + 660000)
                          || (sinalId in ['video', 'voz']
                              && request.resource.data.tipo == sinalId));
        allow update: if valido() && (
          dono()
          || (camera() && resource.data.tipo == 'camera'
              && request.time < timestamp.value(resource.data.expiraEm)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['oferta']))
          || (!camera() && cliente()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta']))
        );
        allow delete: if false;
      }
    }
  }
}
