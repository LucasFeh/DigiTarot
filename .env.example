# Deixe as chaves do Firebase vazias para rodar no modo local (sem conta de
# verdade, tempo real entre abas). Preencha para ligar o Firebase — as chaves
# abaixo são públicas por natureza; quem protege os dados são as regras do
# Firestore, em firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave pública reCAPTCHA Enterprise registrada em Segurança > App Check.
# Configure no ambiente de produção após registrar o domínio real. O código
# só envia tokens; o bloqueio começa quando a API for colocada em "Enforce".
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Quem é o tarólogo NÃO fica aqui: mora em src/lib/backend/tarologo.ts, ao lado
# do mesmo e-mail em firestore.rules. Guardá-lo fora do repositório só criava uma
# cópia que saía de sincronia sem avisar.

# Cada tarólogo cadastra seus dados Pix no próprio perfil. A chave fica em um
# documento privado do Firestore; variáveis VITE_* entram no JavaScript público.

# WhatsApp para o envio do comprovante, só dígitos e com o DDI: 5511999999999.
VITE_WHATSAPP=
