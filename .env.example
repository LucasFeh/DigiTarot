# Deixe tudo vazio para rodar no modo local (sem conta, tempo real entre abas).
# Preencha para ligar o Firebase de verdade — as chaves abaixo são públicas por
# natureza; quem protege os dados são as regras do Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Quem entra como tarólogo, separado por vírgula.
VITE_TAROLOGO_EMAILS=
