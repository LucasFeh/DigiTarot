# Deixe as chaves do Firebase vazias para rodar no modo local (sem conta de
# verdade, tempo real entre abas). Preencha para ligar o Firebase — as chaves
# abaixo são públicas por natureza; quem protege os dados são as regras do
# Firestore, em firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Quem é o tarólogo NÃO fica aqui: mora em src/lib/backend/tarologo.ts, ao lado
# do mesmo e-mail em firestore.rules. Guardá-lo fora do repositório só criava uma
# cópia que saía de sincronia sem avisar.

# ----------------------------- pagamento (Pix) -----------------------------
# Chave Pix do recebedor: CPF, CNPJ, telefone (+5511999999999), e-mail ou chave
# aleatória. Sem ela, a tela de pagamento avisa que o Pix não está configurado
# em vez de gerar um QR Code que não leva a lugar nenhum.
VITE_PIX_CHAVE=
# Nome do recebedor, como aparece no app de quem paga. Máximo 25 caracteres.
VITE_PIX_NOME=
# Cidade do recebedor. Máximo 15 caracteres.
VITE_PIX_CIDADE=

# WhatsApp para o envio do comprovante, só dígitos e com o DDI: 5511999999999.
VITE_WHATSAPP=
